# Copy to .env and fill in. All keys are server-side only — never exposed to the browser,
# never committed (.env is gitignored).

# SEC EDGAR requires a User-Agent identifying you with contact info (no key needed).
EDGAR_USER_AGENT="TickerToModel/0.1 (jmmolone@usc.edu)"

# Alpaca market data (https://alpaca.markets) — used for split-adjusted daily bars.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) — used for the 10Y Treasury (DGS10).
FRED_API_KEY=

# Path for the SQLite runtime cache (graceful-degradation layer).
CACHE_DB_PATH=./cache.sqlite
